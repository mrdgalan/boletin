# Boletin (MagnaRooms fork of listmonk) — Coolify build.
# Multi-stage: bun frontend -> go backend + stuffbin pack -> alpine runtime.
# Upstream Dockerfile intentionally untouched (release flow); this file is ours.
# Build with: docker build -f Dockerfile.coolify .

FROM oven/bun:1 AS frontend
WORKDIR /build/static/admin
COPY static/admin/package.json static/admin/bun.lock ./
RUN bun install --frozen-lockfile
COPY static/admin/ ./
RUN bun run build

FROM golang:1.26.1-bookworm AS backend
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=frontend /build/static/admin/dist ./static/admin/dist
RUN CGO_ENABLED=0 go build -o listmonk -ldflags="-s -w" ./cmd
RUN go install github.com/knadh/stuffbin/... \
 && /root/go/bin/stuffbin -a stuff -in listmonk -out listmonk \
      config.toml.sample schema.sql queries:/queries permissions.json \
      static/public:/public static/admin/views:/admin/views \
      static/admin/partials:/admin/partials static/admin/dist:/admin/static \
      static/admin/i18n.txt:/admin/i18n.txt static/email-templates i18n:/i18n

FROM alpine:latest
RUN apk --no-cache add ca-certificates tzdata shadow su-exec
WORKDIR /listmonk
COPY --from=backend /build/listmonk .
COPY --from=backend /build/config.toml.sample config.toml
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
EXPOSE 9000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["sh", "-c", "./listmonk --install --idempotent --yes --config '' && ./listmonk --upgrade --yes --config '' && ./listmonk --config ''"]
